{
    "manifest_version": 3,
    "version": "1.0",
    "name": "Linkest",
    "action": {
        "default_popup": "index.html",
        "default_icon": "Icon.png"
    },
    "icons": {
        "128": "Icon.png",
        "192": "Icon.png",
        "48": "Icon.png"
     },
    "permissions": [
        "tabs"
    ]
}